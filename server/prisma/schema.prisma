// Monsur Ali Travels ERP - Prisma Schema for PostgreSQL
// Database: PostgreSQL 16+

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  Owner
  Admin
  Manager
  Employee
  Agent
  Staff
}

enum Gender {
  Male
  Female
  Other
}

enum CustomerStatus {
  Active
  Lead
  Inactive
  Blacklisted
  Archived
}

enum CustomerType {
  Individual
  Corporate
  Agent_Referred
  VIP
}

enum ReceiptStatus {
  pending
  confirmed
  cancelled
}

enum PaymentMethod {
  Cash
  Bank_Transfer
  Mobile_Banking
  Cheque
  Other
}

enum CaseStatus {
  ENTRY
  PROCESSING
  APPROVED_OFFER_LETTER
  SUBMITTED_EMBASSY_BSF
  COMPLETED_DELIVERED
  REJECTED
  ON_HOLD
}

enum VisaStage {
  pending
  submitted
  accepted
  rejected
  delivered
}

// ==========================================
// MODELS
// ==========================================

model User {
  id                    String         @id @default(uuid())
  did                   String         @unique
  name                  String
  email                 String         @unique
  phone                 String
  passwordHash          String
  role                  UserRole       @default(Employee)
  department            String         @default("")
  designation           String         @default("")
  assets                String[]       @default([])
  isActive              Boolean        @default(true)
  lastLogin             DateTime?

  // Relations
  createdCustomers      Customer[]     @relation("CustomerCreatedBy")
  updatedCustomers      Customer[]     @relation("CustomerUpdatedBy")
  createdReceipts       MoneyReceipt[] @relation("ReceiptCreatedBy")
  confirmedReceipts     MoneyReceipt[] @relation("ReceiptConfirmedBy")
  createdCases          CaseFile[]     @relation("CaseCreatedBy")
  updatedCases          CaseFile[]     @relation("CaseUpdatedBy")

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@map("users")
}

model Customer {
  id                    String         @id @default(uuid())
  did                   String         @unique
  customerCode          String         @unique // CUST-XXXXXX
  fullName              String
  nidNumber             String?        @default("")
  passportNumber        String?        @default("")
  passportExpiryDate    String?        @default("")
  birthDate             String?        @default("")
  gender                Gender         @default(Male)
  bloodGroup            String?        @default("")
  maritalStatus         String?        @default("")

  // Contact & Address
  phone                 String
  altPhone              String?        @default("")
  email                 String?        @default("")
  presentAddress        String?        @default("")
  permanentAddress      String?        @default("")
  district              String?        @default("")
  policeStation         String?        @default("")
  postCode              String?        @default("")

  // Family Info
  fatherName            String?        @default("")
  motherName            String?        @default("")
  spouseName            String?        @default("")

  // Guardian & Attachments (JSONB for rich flexible storage)
  guardian              Json?          @default("{}") // { name, relationship, phone, nidNumber, fatherName, motherName, address }
  attachments           Json?          @default("{\"photo\":\"\",\"passportScan\":\"\",\"nidScan\":\"\",\"otherDocuments\":[]}")

  // Financial Ledger Summary
  totalBilledAmount     Decimal        @default(0.00) @db.Decimal(12, 2)
  totalPaidAmount       Decimal        @default(0.00) @db.Decimal(12, 2)
  totalDueAmount        Decimal        @default(0.00) @db.Decimal(12, 2)

  status                CustomerStatus @default(Active)
  customerType          CustomerType   @default(Individual)
  remarks               String?        @default("")
  isActive              Boolean        @default(true)

  // Audit Relations
  createdById           String?
  createdBy             User?          @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById           String?
  updatedBy             User?          @relation("CustomerUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  // Subordinated Relational Collections
  receipts              MoneyReceipt[]
  cases                 CaseFile[]
  visaSubmissions       IndianVisaSubmission[]
  passportSubmissions   PassportSubmission[]
  applications          CustomerGuardianApplication[]
  invoices              Invoice[]
  agreements            EmploymentAgreement[]
  candidateCases        CandidateCaseFile[]

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([fullName, phone, passportNumber, nidNumber, customerCode])
  @@map("customers")
}

model MoneyReceipt {
  id                    String         @id @default(uuid())
  did                   String         @unique
  receiptNo             String         @unique // MR-YYMMDD-XXXX

  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Snapshot details for ultra-fast indexing
  clientName            String
  clientPhone           String?        @default("")
  passportNumber        String?        @default("")
  serviceType           String         @default("অন্যান্য")
  purpose               String?        @default("")

  amount                Decimal        @db.Decimal(12, 2)
  amountInWords         String?        @default("")
  currency              String         @default("BDT")
  paymentMethod         PaymentMethod  @default(Cash)
  status                ReceiptStatus  @default(pending)

  // Creator & Confirming Accountant Audit
  createdById           String?
  createdBy             User?          @relation("ReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdByName         String         @default("ম্যানেজার")

  confirmedById         String?
  confirmedBy           User?          @relation("ReceiptConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedByName       String?        @default("")
  confirmedAt           DateTime?

  // Bank Deposit Handover
  handedOverToBank      Boolean        @default(false)
  bankDepositRef        String?        @default("")
  bankDepositDate       DateTime?

  notes                 String?        @default("")
  serviceRef            Json?          @default("{}") // { modelName, docId, trackingId }
  isActive              Boolean        @default(true)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([receiptNo, clientName, clientPhone, passportNumber, status])
  @@map("money_receipts")
}

model CaseFile {
  id                    String         @id @default(uuid())
  did                   String         @unique
  caseNumber            String         @unique // CS-YYYY-XXXX

  customerId            String
  customer              Customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)

  applicantName         String
  passportNumber        String?        @default("")
  phone                 String?        @default("")
  nidNumber             String?        @default("")
  caseType              String         // 'greece', 'n-macedonia', 'indian-bsf', etc.
  status                CaseStatus     @default(ENTRY)

  // Document Checklist & Reminders (JSONB)
  checklist             Json?          @default("{\"photo2x2\":false,\"electricityBill\":false,\"nidCopy\":false,\"landDocuments\":false,\"notes\":\"\"}")

  // 3-Stage Payment Milestones
  totalAgreedAmount     Decimal        @default(0.00) @db.Decimal(12, 2)
  step1_advance         Decimal        @default(0.00) @db.Decimal(12, 2)
  step2_offerApproval   Decimal        @default(0.00) @db.Decimal(12, 2)
  step3_delivery        Decimal        @default(0.00) @db.Decimal(12, 2)
  totalPaidAmount       Decimal        @default(0.00) @db.Decimal(12, 2)
  dueAmount             Decimal        @default(0.00) @db.Decimal(12, 2)
  isFullyPaid           Boolean        @default(false)

  extraData             Json?          @default("{}")
  remarks               String?        @default("")
  isActive              Boolean        @default(true)

  createdById           String?
  createdBy             User?          @relation("CaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById           String?
  updatedBy             User?          @relation("CaseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([caseNumber, applicantName, passportNumber, status, caseType])
  @@map("case_files")
}

model IndianVisaSubmission {
  id                    String         @id @default(uuid())
  did                   String         @unique
  trackingNo            String         @unique // IVISA-XXXXXXXXXX

  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  applicantName         String
  passportNo            String
  contactNo             String?        @default("")
  email                 String?        @default("")
  visaType              String         @default("Tourist")
  status                VisaStage      @default(pending)
  fee                   Decimal        @default(0.00) @db.Decimal(10, 2)

  applicantData         Json?          @default("{}")
  documents             Json?          @default("[]")
  stageHistory          Json?          @default("[]")
  isActive              Boolean        @default(true)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([trackingNo, applicantName, passportNo, status])
  @@map("indian_visa_submissions")
}

model PassportSubmission {
  id                    String         @id @default(uuid())
  did                   String         @unique
  trackingNo            String         @unique // PASS-XXXXXXXXXX

  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  applicantName         String
  applicantPhone        String?        @default("")
  passportNo            String?        @default("")
  passportType          String?        @default("E-Passport")
  applicationCategory   String?        @default("Renewal")
  submissionDate        DateTime?      @default(now())
  status                String         @default("Pending")
  fee                   Decimal        @default(0.00) @db.Decimal(10, 2)

  details               Json?          @default("{}")
  isActive              Boolean        @default(true)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([trackingNo, applicantName, passportNo, status])
  @@map("passport_submissions")
}

model CustomerGuardianApplication {
  id                    String         @id @default(uuid())
  did                   String         @unique
  applicationNo         String         @unique // CGA-XX-XXXXXX

  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  serviceType           String         @default("ইন্ডিয়ান ভিসা")
  customerData          Json
  guardianData          Json
  requirementDocuments  Json?          @default("[]")
  payment               Json?          @default("{\"totalAmount\":0,\"advancePaid\":0,\"dueAmount\":0,\"paymentStatus\":\"Unpaid\"}")
  attachments           Json?          @default("{\"passportPhoto\":\"\",\"passportScan\":\"\",\"nidScan\":\"\",\"otherFiles\":[]}")
  status                String         @default("received")
  activityLogs          Json?          @default("[]")
  officeNotes           String?        @default("")
  isActive              Boolean        @default(true)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([applicationNo, status])
  @@map("customer_guardian_applications")
}

model CandidateCaseFile {
  id                    String         @id @default(uuid())
  did                   String         @unique
  caseNo                String         @unique // MP-YYYY-XXXX

  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  candidateName         String
  passportNumber        String?        @default("")
  countryApplied        String
  jobCategory           String
  stage                 String         @default("Medical")
  paymentSummary        Json?          @default("{\"totalFee\":0,\"paidAmount\":0,\"dueAmount\":0}")
  details               Json?          @default("{}")
  isActive              Boolean        @default(true)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([caseNo, candidateName, passportNumber])
  @@map("candidate_case_files")
}

model Invoice {
  id                    String         @id @default(uuid())
  did                   String         @unique
  invoiceNo             String         @unique // I-XXXXXXXXXX

  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  issueDate             DateTime       @default(now())
  dueDate               DateTime?
  paymentStatus         String         @default("Pending")
  currency              String         @default("BDT")
  taxRate               Decimal        @default(0.00) @db.Decimal(5, 2)

  biller                Json
  client                Json
  items                 Json           // Array of items
  paymentTerms          String?        @default("")

  subtotal              Decimal        @default(0.00) @db.Decimal(12, 2)
  taxAmount             Decimal        @default(0.00) @db.Decimal(12, 2)
  grandTotal            Decimal        @default(0.00) @db.Decimal(12, 2)
  isActive              Boolean        @default(true)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([invoiceNo, paymentStatus])
  @@map("invoices")
}

model EmploymentAgreement {
  id                    String         @id @default(uuid())
  did                   String         @unique
  agreementId           String         @unique // AGR-XXXXXXXX

  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)

  companyInfo           Json
  partyInfo             Json
  guardianInfo          Json?
  positionInfo          Json
  salaryStructure       Json
  leavePolicy           Json?
  witnesses             Json?
  status                String         @default("active")
  isActive              Boolean        @default(true)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([agreementId, status])
  @@map("employment_agreements")
}

model SalarySlip {
  id                    String         @id @default(uuid())
  did                   String         @unique
  slipNo                String         @unique // SLIP-XXXXXXXXXX

  employeeName          String
  designation           String?        @default("")
  monthYear             String
  earnings              Json
  deductions            Json
  netSalary             Decimal        @db.Decimal(12, 2)
  isActive              Boolean        @default(true)

  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([slipNo, employeeName, monthYear])
  @@map("salary_slips")
}
