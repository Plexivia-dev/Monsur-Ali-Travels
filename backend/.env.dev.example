ACCESS_TOKEN_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_MS=2592000000
ALLOW_SUPER_ADMIN_CREATION=true

ALLOWED_ORIGINS=https://admin.plexivia.online,http://admin.plexivia.online,https://dash.plexivia.online,http://dash.plexivia.online,https://dashboard.plexivia.online,http://dashboard.plexivia.online,https://server.plexivia.online,http://server.plexivia.online,https://api.plexivia.online,http://api.plexivia.online,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://localhost:8000,http://localhost:8001,http://localhost:8004,http://localhost:8005,http://localhost:8006,http://localhost:8007,http://localhost:8015,http://localhost:8017,http://localhost:5092,http://localhost:5093
FRONTEND_DOMAIN_KEYWORDS=localhost,monsuralitravelsbd.com,plexivia.online
DASHBOARD_DOMAIN_KEYWORDS=admin,dash,dashboard,localhost,plexivia.online

SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_ENCRYPTION=TLS
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_NAME=Monsur Ali Travels (Dev)

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=monsuralitravels-erp-docs-dev
R2_ENDPOINT=https://your_r2_account_id.r2.cloudflarestorage.com

# Storage Paths
UPLOAD_PATH=/app/uploads
DOCUMENT_PATH=/app/documents

# Storage Maintenance & Orphan File Scheduler
STORAGE_MAINTENANCE_ENABLED=true
STORAGE_MAINTENANCE_INTERVAL_HOURS=48
STORAGE_MAINTENANCE_RUN_ON_STARTUP=false
