NODE_ENV=development
PORT=5092
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/perfume-store
MONGODB_DB_NAME=perfume-store

# JWT / Security Tokens
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_key_at_least_20_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_MS=2592000000

# White-Label Domain Routing & CORS Setup (Comma-separated lists)
ALLOWED_ORIGINS=http://localhost:8001,http://localhost:8005,http://localhost:3000
FRONTEND_DOMAIN_KEYWORDS=localhost,monsuralitravelsbd.com
DASHBOARD_DOMAIN_KEYWORDS=dashboard,localhost:8005

# Cloudflare R2 Storage Configuration
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=monsuralitravels-erp-docs
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
# R2_PUBLIC_DOMAIN=https://cdn.yourdomain.com

# Storage Maintenance & Orphan File Scheduler
STORAGE_MAINTENANCE_ENABLED=true
STORAGE_MAINTENANCE_INTERVAL_HOURS=48
STORAGE_MAINTENANCE_RUN_ON_STARTUP=false


