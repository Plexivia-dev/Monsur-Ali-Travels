{
  "name": "ERP-Dash",
  "private": true,
  "version": "3.4.09",
  "type": "module",
  "scripts": {
    "dev": "npx concurrently -n \"ADMIN,CLIENT\" -c \"bgBlue.bold,bgMagenta.bold\" \"npm run dev:admin\" \"npm run dev:client\"",
    "dev:admin": "vite --config vite.admin.config.js",
    "dev:client": "vite --config vite.client.config.js",
    "build": "npm run build:admin && npm run build:client",
    "build:admin": "vite build --config vite.admin.config.js",
    "build:client": "vite build --config vite.client.config.js",
    "preview:admin": "vite preview --config vite.admin.config.js",
    "preview:client": "vite preview --config vite.client.config.js",
    "lint": "oxlint"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^9.1.2",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "html-to-image": "^1.11.13",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^9.1.2",
    "oxlint": "^1.75.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
